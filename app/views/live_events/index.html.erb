<div data-controller="live-events">
  <h2>参戦予定リスト</h2>
  
  <%= link_to "新規作成", new_live_event_path %>
  <table>
    <tr>
      <th>参戦済</th>
      <th>開催日</th>
      <th>公演名</th>
      <th>会場</th>
      <th>更新日時</th>
      <th>ライブログ</th>
      <th></th>
    </tr>

    <% @live_events.each do |live_event| %>
      <tr>
        <td>
          <label class="attended-toggle">
            <%= check_box_tag "live_event_ids[]", live_event.id, live_event.attended,
            data: { action: "change->live-events#toggleAttended" },
            class: "attended-checkbox" %>
            <span class="attended-note">♪</span> <%# 後で♪の色と大きさを変更 %>
          </label>
        </td>

        <td>📅<%= live_event.event_date.strftime("%Y/%m/%d") %></td>
        <td><%= live_event.title %></td>
        <td>📍<%= live_event.venue_name %></td>
        <td><%= live_event.updated_at.strftime("%Y/%m/%d %H:%M") %></td>

        <td>
          <div
            data-live-event-id="<%= live_event.id %>"
            data-live-events-target="liveLogLink"
            class="<%= live_event.attended? ? '' : 'is-hidden' %>"
          >
            <%= link_to "✎", new_live_event_live_log_path(live_event) %>
          </div>
        </td>

        <td>
          <details>
            <summary>︙</summary>
            <ul>
              <li><%= link_to "編集", edit_live_event_path(live_event) %></li>
              <li><%= link_to "削除", live_event_path(live_event), data: {turbo_method: :delete, turbo_confirm: "「#{live_event.title}」 を削除しますか？"} %></li>
            </ul>
          </details>
        </td>
      </tr>
    <% end %>
    
  </table>
</div>