<div>
  <%= form_with model: @live_event do |f| %>

  <div>
    <%= f.label :event_date, "📅" %>
    <%= f.date_field :event_date %>
  </div>

  <div>
    <%= f.label :title, "公演名" %>
    <%= f.text_field :title, placeholder: "公演名を入力" %>
  </div>

  <div>
    <%= f.label :artist_name, "目当てのアーティスト" %>
    <%= f.text_field :artist_name, placeholder: "目当てのアーティストを入力" %>
  </div>

  <div>
    <%= f.label :venue_name, "📍" %>
    <%= f.text_field :venue_name, placeholder: "会場名を入力" %>
  </div>

  <div>
    <%= f.submit "保存" %>
    <%= link_to "キャンセル", request.referer || root_path %>
  </div>


  <% end %>
<div>