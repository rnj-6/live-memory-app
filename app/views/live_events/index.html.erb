<div>
  <h2>参戦予定リスト</h2>
  
  <%= link_to "新規作成", new_live_event_path %>
  <table>
    <tr>
        <th></th>
      <th>📅</th>
      <th>公演名</th>
      <th>会場</th>
      <th>更新日時</th>
    </tr>

    <% @live_events.each do |ive_event| %>
      <tr>
        <td></td>
        <td><%= live_event.event_date %></td>
        <td><%= live_event.title %></td>
        <td><%= live_event.venue_name %></td>
        <td><%= live_event.updated_at.strftime("%Y/%m/%d %H:%M") %></td>
      </tr>
    <% end %>
  </table>
</div>